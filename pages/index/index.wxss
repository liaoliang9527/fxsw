/* 首页使用内容盒自适应，避免百分比宽高叠加内边距后溢出。 */
.menu-screen{display:flex;flex-direction:column}
.menu-header{height:auto;flex:0 0 21%;min-height:0;padding-left:max(28rpx,env(safe-area-inset-left));padding-right:max(28rpx,env(safe-area-inset-right))}
.menu-body{height:auto;flex:1;min-height:0;width:100%;padding:2vh max(28rpx,env(safe-area-inset-right)) max(18rpx,env(safe-area-inset-bottom)) max(28rpx,env(safe-area-inset-left));gap:22rpx}
.role-area{width:auto;flex:1;min-width:0}
.role-list{gap:14rpx;min-width:0}
.role-card{min-width:0}
.menu-actions{gap:12rpx;padding-top:13rpx;flex:0 0 auto}
.menu-actions button{flex:1;min-width:0;height:58rpx;padding:0 20rpx;font-size:21rpx;letter-spacing:3rpx}
.map-panel{width:auto;flex:0 0 27%;min-width:0;padding:17rpx;display:flex;flex-direction:column}
.map-panel .section-title{flex:0 0 auto}
.map-image{height:auto;flex:0 0 43%;min-height:0}

@media (max-height: 430px){
  .menu-header{flex-basis:19%}
  .menu-body{padding-top:10rpx;padding-bottom:max(10rpx,env(safe-area-inset-bottom));gap:14rpx}
  .eyebrow{font-size:16rpx;letter-spacing:4rpx}
  .game-title{font-size:46rpx;line-height:1}
  .tagline{font-size:16rpx;letter-spacing:5rpx}
  .wallet{padding:8rpx 15rpx}
  .wallet image{width:28rpx;height:28rpx}
  .section-title{font-size:21rpx;margin-bottom:7rpx}
  .role-list{gap:10rpx}
  .role-copy{height:38%;padding:7rpx 10rpx}
  .role-card>image{height:66%}
  .role-name{font-size:22rpx}
  .role-type{font-size:15rpx}
  .role-trait{display:block;font-size:13rpx;margin-top:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .menu-actions{padding-top:8rpx;gap:8rpx}
  .menu-actions button{height:46rpx;padding:0 10rpx;font-size:17rpx;letter-spacing:2rpx}
  .map-panel{padding:11rpx;flex-basis:26%}
  .map-image{flex-basis:42%}
  .map-badge{font-size:15rpx;padding:4rpx 8rpx}
  .map-copy{font-size:15rpx;line-height:1.45;margin-top:8rpx}
  .map-stats{gap:5rpx;margin-top:6rpx}
  .map-stats text{font-size:12rpx;padding:3rpx 6rpx}
}

@media (max-width: 700px){
  .menu-header{padding-left:max(18rpx,env(safe-area-inset-left));padding-right:max(18rpx,env(safe-area-inset-right))}
  .menu-body{padding-left:max(18rpx,env(safe-area-inset-left));padding-right:max(18rpx,env(safe-area-inset-right));gap:12rpx}
  .map-panel{flex-basis:25%}
  .map-copy{line-height:1.35}
}

/* 横屏下 rpx 会随屏幕宽度放大，文字统一改用稳定的 px 尺寸。 */
.eyebrow{font-size:10px;letter-spacing:3px}
.game-title{font-size:29px;line-height:1.06;letter-spacing:5px}
.tagline{font-size:11px;letter-spacing:4px}
.wallet{font-size:13px}
.section-title{font-size:15px;letter-spacing:2px}
.role-name{font-size:16px}
.role-type{font-size:11px}
.role-trait{font-size:10px}
.menu-actions button,.modal-actions button{font-size:13px;letter-spacing:2px}
.map-badge{font-size:11px}
.map-copy{font-size:11px}
.map-stats text{font-size:10px}

.identity{font-size:13px}
.identity text:last-child{font-size:11px}
.meter-row{font-size:10px}
.chapter{font-size:10px;letter-spacing:2px}
.timer{font-size:20px;letter-spacing:3px}
.objective{font-size:10px}
.boss-meter>text{font-size:11px}
.coin{font-size:13px}
.pause-button{font-size:15px}
.build-panel>text{font-size:8px}
.build-slot text{font-size:7px}
.toast{font-size:13px;letter-spacing:2px}

.modal-title{font-size:22px;letter-spacing:3px}
.modal-subtitle{font-size:12px}
.choice-name{font-size:16px}
.choice-level{font-size:11px}
.choice-desc{font-size:11px}
.choice-tag{font-size:10px}
.run-summary,.pause-build text{font-size:11px}
.run-summary .strong{font-size:17px}
.result-grid text{font-size:11px}
.result-grid .result-value{font-size:23px}
.reward-name{font-size:19px!important}
.reward text{font-size:12px}
.talent-node text{font-size:13px}
.talent-node .talent-level{font-size:11px}
.talent-node .talent-cost{font-size:10px}
.settings-list text{font-size:13px}
.small-button{font-size:11px!important}

@media (max-height: 390px){
  .game-title{font-size:25px}
  .section-title{font-size:13px}
  .role-name{font-size:14px}
  .role-type,.map-copy{font-size:10px}
  .role-trait{font-size:9px}
  .menu-actions button{font-size:11px;letter-spacing:1px}
}

/* 战斗 HUD 使用横屏逻辑像素，避免 rpx 按屏幕宽度放大并相互遮挡。 */
.player-panel{top:max(10px,env(safe-area-inset-top));left:max(12px,env(safe-area-inset-left));width:32vw;max-width:285px;min-width:238px;height:64px;padding:7px 10px 7px 68px}
.hud-portrait{left:-3px;top:-3px;width:66px;height:66px;border-width:2px;box-shadow:0 0 0 3px #101a23,0 4px 10px #000}
.identity{font-size:12px}
.identity text:last-child{font-size:10px}
.meter-row{gap:4px;margin-top:3px;font-size:9px}
.meter-row>text:first-child{width:25px}
.meter-row>text:last-child{width:48px}
.meter{height:6px;border-width:1px}
.hp-track{height:8px}.xp-track{height:5px}

.time-panel{top:max(8px,env(safe-area-inset-top));min-width:176px;max-width:210px;padding:5px 14px}
.chapter{font-size:9px;letter-spacing:2px}
.timer{font-size:19px;line-height:1.05;letter-spacing:2px}
.objective{font-size:9px;margin-top:2px}
.boss-meter{width:300px;top:66px;padding:5px 9px}
.boss-meter>text{font-size:10px}
.horde-alert{display:block;margin-top:3px;color:#ffb46d;font-size:10px;font-weight:700;letter-spacing:1px;text-shadow:0 0 8px #d94d2f}

.right-panel{height:46px;padding:5px 7px;gap:8px}
.coin{gap:4px;min-width:58px;font-size:12px}
.coin image{width:25px;height:25px}
.pause-button{width:34px;height:34px;font-size:14px}

.build-panel{top:87px;left:max(12px,env(safe-area-inset-left));width:54px;padding:5px}
.build-panel>text{font-size:8px;margin-bottom:4px}
.build-grid{gap:3px}
.passive-grid{margin-top:5px;padding-top:5px}
.build-slot{width:20px;height:20px}
.build-slot text{right:-3px;bottom:-3px;width:11px;height:11px;line-height:10px;font-size:7px}

.joystick{left:max(22px,env(safe-area-inset-left));bottom:max(18px,env(safe-area-inset-bottom));width:104px;height:104px;border-width:1px}
.stick{left:35px;top:35px;width:34px;height:34px;border-width:1px}
.toast{top:16%;min-width:230px;padding:8px 22px;font-size:12px;letter-spacing:1px}

@media (max-width: 700px){
  .player-panel{width:31vw;min-width:218px;height:58px;padding-left:61px}
  .hud-portrait{width:60px;height:60px}
  .time-panel{min-width:155px;padding-left:9px;padding-right:9px}
  .timer{font-size:17px}
  .right-panel{height:42px}
  .coin{min-width:50px}
  .pause-button{width:31px;height:31px}
  .build-panel{top:79px}
}

@media (max-width: 600px){
  .player-panel{width:190px;min-width:190px}
  .meter-row>text:last-child{display:none}
  .time-panel{min-width:140px;max-width:140px}
  .chapter{letter-spacing:1px}
}

/* 无尽轮回弹窗与结算 */
.endless-content{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
.endless-content>view{text-align:center;padding:14px 10px;border:1px solid #607486;background:#08121a}
.endless-content text{display:block;color:#aebbc5;font-size:11px}
.endless-content .endless-value{color:#f2ce82;font-family:serif;font-size:15px;margin-top:6px}
.result-grid.four{grid-template-columns:repeat(4,1fr)}
